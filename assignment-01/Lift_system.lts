/* ------------ SYSTEM CONSTANTS ----------- */
const MIN_FLOOR		= 0												// Piano più basso (piano terra)
const MAX_FLOOR		= 3												// Piano più alto
const GROUND_FLOOR	= 0 											// Piano in cui va l'ascensore in caso di allarme
const DOORS_CLOSED	= 0 											// Porte dell'ascensore chiuse
const DOORS_OPEN	= 1 											// Porte dell'ascensore aperte
const EMPTY			= MAX_FLOOR + 1									// Cabina vuota (nessun passeggero)
const NONE			= MAX_FLOOR + 1									// Slot vuoto della coda delle chiamate

/* ---------------- RANGES ---------------- */
range FLOORS = MIN_FLOOR..MAX_FLOOR									// Piani dell'edificio
range DOORS = DOORS_CLOSED..DOORS_OPEN								// Stati delle porte
range PASSENGERS = MIN_FLOOR..EMPTY									// Passeggero a bordo: utente del piano p, oppure EMPTY
range SLOT = MIN_FLOOR..NONE										// Contenuto di uno slot della coda: piano chiamante, oppure NONE

/* ----------------- LIFT ----------------- */
// f = piano corrente, t = destinazione, p = passeggero a bordo (utente del piano p) oppure EMPTY
LIFT = IDLE[MIN_FLOOR][EMPTY],	// Stato iniziale: fermo al piano terra, porte chiuse, cabina vuota

// ASCENSORE FERMO CON PORTE CHIUSE AL PIANO f
IDLE[f:FLOORS][p:PASSENGERS] =
	(when (p != EMPTY) select[p][t:FLOORS] -> GO[f][t][p]			// Pulsante interno: il passeggero chiede il piano t
	|when (p == EMPTY) request[t:FLOORS] -> GO[f][t][p]				// Cabina vuota: prende in carico la chiamata in testa alla coda (piano t)
	|open_door_button -> OPENING[f][p]								// Pulsante apertura: apri le porte rimanendo al piano f
	|alarm -> ALARM_RECEIVED[f][DOORS_CLOSED][p]),					// Allarme ricevuto

// SCELTA: se f è la destinazione apri le porte, altrimenti muoviti
GO[f:FLOORS][t:FLOORS][p:PASSENGERS] =
	if (f == t)
	then OPENING[f][p]
	else MOVING[f][t][p],

// SPOSTAMENTO: f = piano corrente, t = destinazione
MOVING[f:FLOORS][t:FLOORS][p:PASSENGERS] =
	(when (f < t) at[f+1] -> GO[f+1][t][p]							// Salita di un piano
	|when (f > t) at[f-1] -> GO[f-1][t][p]							// Discesa di un piano
	|alarm -> ALARM_RECEIVED[f][DOORS_CLOSED][p]),					// Allarme ricevuto

// PORTE IN APERTURA AL PIANO f (si apre solo a destinazione raggiunta)
OPENING[f:FLOORS][p:PASSENGERS] =
	(door_opened -> OPEN[f][f][p]									// Porte completamente aperte
	|alarm -> ALARM_RECEIVED[f][DOORS_OPEN][p]),					// Allarme ricevuto

// PORTE APERTE
OPEN[f:FLOORS][t:FLOORS][p:PASSENGERS] =
	(when (p == EMPTY) enter[f] -> OPEN[f][f][f]					// Cabina vuota: sale l'utente del piano f
	|when (p != EMPTY) exit[p][f] -> OPEN[f][f][EMPTY]				// Il passeggero scende al piano f
	|when (p != EMPTY) select[p][n:FLOORS] -> CLOSING[f][n][p]		// Il passeggero sceglie il piano n: chiudi e imposta la nuova destinazione
	|{timeout, close_door_button} -> CLOSING[f][t][p]				// Timeout per inattività o pulsante chiusura: inizia a chiudere
	|alarm -> ALARM_RECEIVED[f][DOORS_OPEN][p]),					// Allarme ricevuto

// PORTE IN CHIUSURA
CLOSING[f:FLOORS][t:FLOORS][p:PASSENGERS] =
	({open_door_button, sensor_obstacle} -> OPEN[f][t][p]			// Pulsante apertura o ostacolo rilevato: riapri
	|door_closed -> if (f == t) then IDLE[f][p] else MOVING[f][t][p]	// Porte chiuse: se non c'è destinazione resta fermo, altrimenti parti
	|alarm -> ALARM_RECEIVED[f][DOORS_OPEN][p]),					// Allarme ricevuto

// ALLARME RICEVUTO: decide cosa fare in base alle porte e alla posizione dell'ascensore
ALARM_RECEIVED[f:FLOORS][d:DOORS][p:PASSENGERS] =
	if (d == DOORS_CLOSED) then ALARM_DOWN[f][p]					// Porte chiuse: vai al piano terra e apri
	else if (d == DOORS_OPEN && f == GROUND_FLOOR) then EVACUATE[p]	// Già aperte a piano terra: evacua ed entra in allarme
	else ALARM_CLOSING[f][p],										// Altrove: chiudi le porte e scendi al piano terra

// ALLARME - CHIUSURA PORTE PER ANDARE AL PIANO TERRA
ALARM_CLOSING[f:FLOORS][p:PASSENGERS] = (door_closed -> ALARM_DOWN[f][p]),

// ALLARME - DISCESA AL PIANO TERRA SENZA FERMATE INTERMEDIE
ALARM_DOWN[f:FLOORS][p:PASSENGERS] =
	if (f == GROUND_FLOOR)
	then ALARM_OPENING[p]
	else (at[f-1] -> ALARM_DOWN[f-1][p]),

// ALLARME - APERTURA PORTE A PIANO TERRA
ALARM_OPENING[p:PASSENGERS] = (door_opened -> EVACUATE[p]),

// ALLARME - EVACUAZIONE DELL'EVENTUALE PASSEGGERO A PIANO TERRA
EVACUATE[p:PASSENGERS] =
	if (p == EMPTY)
	then LIFT_ALARM
	else (evacuate[p] -> LIFT_ALARM),

// ASCENSORE IN ALLARME, ATTESA RISOLUZIONE E RITORNA IN SERVIZIO
LIFT_ALARM = (alarm_solved -> OPEN[GROUND_FLOOR][GROUND_FLOOR][EMPTY]).

/* ----------------- USER ----------------- */
// Utente del piano H: chiama, sale, sceglie il piano e scende (oppure viene evacuato in caso di allarme)
USER(H=0) = (call[H] -> WAITING),									// Preme il pulsante di chiamata esterno
WAITING = (enter[H] -> INSIDE),										// Sale quando l'ascensore è al suo piano a porte aperte
INSIDE =
	(select[H][d:FLOORS] -> RIDING[d]								// Pulsante interno: sceglie il piano d
	|evacuate[H] -> USER),											// Allarme: evacuato a piano terra
RIDING[d:FLOORS] =
	(exit[H][d] -> USER												// Scende al piano scelto
	|evacuate[H] -> USER).											// Allarme: evacuato a piano terra

||USERS = (forall[h:FLOORS] USER(h)).

/* -------------- CALL QUEUE -------------- */
// Coda FIFO delle chiamate esterne: uno slot per piano (MAX_FLOOR = 3 -> 4 slot), a = testa, d = ultimo slot
// NB: se cambia MAX_FLOOR va aggiunto/rimosso a mano uno slot in Q e un ramo in ogni catena di if
CALL_QUEUE = Q[NONE][NONE][NONE][NONE],
Q[a:SLOT][b:SLOT][c:SLOT][d:SLOT] =
	(call[f:FLOORS] ->												// Nuova chiamata dal piano f
		if (f == a || f == b || f == c || f == d) then Q[a][b][c][d]	// Già in coda: nessun effetto
		else if (a == NONE) then Q[f][b][c][d]						// Accodata nel primo slot libero
		else if (b == NONE) then Q[a][f][c][d]
		else if (c == NONE) then Q[a][b][f][d]
		else Q[a][b][c][f]
	|when (a != NONE) request[a] -> Q[b][c][d][NONE]				// L'ascensore prende in carico solo la testa: dequeue con shift
	|enter[f:FLOORS] ->												// Utente del piano f salito prima del suo turno: rimosso dalla coda
		if (a == f) then Q[b][c][d][NONE]
		else if (b == f) then Q[a][c][d][NONE]
		else if (c == f) then Q[a][b][d][NONE]
		else if (d == f) then Q[a][b][c][NONE]
		else Q[a][b][c][d]).

/* -------------- FIRE ALARM -------------- */
FIRE_ALARM = (alarm -> alarm_solved -> FIRE_ALARM).					// Impianto antincendio esterno: alterna allarme e risoluzione

/* -------------- COMPOSIZIONE DEI SISTEMI -------------- */
||SYS = (LIFT || USERS || CALL_QUEUE || FIRE_ALARM).
