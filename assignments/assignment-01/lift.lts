/*
	+--------------------------------------+
	|           SYSTEM CONSTANTS           |
	+--------------------------------------+
*/
// Floor configuration
const MIN_FLOOR		= 0									// Lowest floor (ground floor)
const MAX_FLOOR		= 2									// Highest floor (with 4 floors and M = 2, the system has ~9.2M states)
const GROUND_FLOOR	= 0									// Floor reached by the lift in case of an alarm
// User configuration
const M				= 2									// Number of users per floor (states: M = 1 -> 918, M = 2 -> 117378)
const N_USERS		= (MAX_FLOOR - MIN_FLOOR + 1) * M	// Total number of users (= queue capacity)
// Cabin states
const EMPTY			= 0									// Empty cabin
const FULL			= 1									// Occupied cabin (capacity 1)

/*
	+--------------------------------------+
	|               RANGES                 |
	+--------------------------------------+
*/
range FLOORS = MIN_FLOOR..MAX_FLOOR						// Building floors
range USER_IDX = 1..M									// User index within a floor
range CABIN_STATE = EMPTY..FULL							// Cabin occupancy
range QUEUE_POS = 0..N_USERS-1							// Possible queue positions

/*
	+--------------------------------------+
	|                LIFT                  |
	+--------------------------------------+

	Index dictionary:
	- f = current floor
	- t = destination floor
	- p = cabin occupancy (EMPTY/FULL)
*/

// INITIAL STATE
LIFT = IDLE[GROUND_FLOOR][EMPTY],													// Lift stopped at the ground floor, doors closed, cabin empty

// LIFT STOPPED WITH CLOSED DOORS AT FLOOR f
IDLE[f:FLOORS][p:CABIN_STATE] =
	(when (p == FULL) select[h:FLOORS][u:USER_IDX][t:FLOORS] -> GO[f][t][p]			// Full cabin: passenger selects floor t using the internal button
	|when (p == EMPTY) request[h:FLOORS][u:USER_IDX] -> GO[f][h][p]					// Empty cabin: goes to the user at the head of the queue (floor h)
	|open_door_button -> OPENING[f][p]												// Open-door button: open the doors while remaining at floor f
	|alarm -> ALARM_DOWN[f][p]),													// Alarm with closed doors: go down to the ground floor

// CHOICE: open the doors if already at the destination; otherwise move
GO[f:FLOORS][t:FLOORS][p:CABIN_STATE] =
	if (f == t)
	then OPENING[f][p]
	else MOVING[f][t][p],

// MOVEMENT: decide whether to go up or down
MOVING[f:FLOORS][t:FLOORS][p:CABIN_STATE] =
	(when (f < t) at[f+1] -> GO[f+1][t][p]											// Go up one floor
	|when (f > t) at[f-1] -> GO[f-1][t][p]											// Go down one floor
	|alarm -> ALARM_DOWN[f][p]),													// Alarm with closed doors: go down to the ground floor

// OPENING THE DOORS AT A FLOOR
OPENING[f:FLOORS][p:CABIN_STATE] =
	(door_opened -> OPEN[f][f][p]													// Doors fully open
	|alarm -> ALARM_OPEN[f][p]),													// Alarm while the doors are not closed

// DOORS OPEN
OPEN[f:FLOORS][t:FLOORS][p:CABIN_STATE] =
	(when (p == EMPTY) enter[f][u:USER_IDX] -> OPEN[f][f][FULL]						// Empty cabin: a user from floor f enters (only the queue head is admitted)
	|when (p == FULL) exit[h:FLOORS][u:USER_IDX][f] -> OPEN[f][f][EMPTY]			// Full cabin: the passenger exits at floor f
	|when (p == FULL) select[h:FLOORS][u:USER_IDX][n:FLOORS] -> CLOSING[f][n][p]	// Full cabin: the passenger selects floor n
	|{timeout, close_door_button} -> CLOSING[f][t][p]								// Inactivity timeout or close-door button: start closing the doors
	|alarm -> ALARM_OPEN[f][p]),													// Alarm while the doors are not closed

// CLOSING THE DOORS
CLOSING[f:FLOORS][t:FLOORS][p:CABIN_STATE] =
	({open_door_button, sensor_obstacle} -> OPEN[f][t][p]							// Reopen button or detected obstacle: reopen the doors
	|door_closed -> if (f == t) then IDLE[f][p] else MOVING[f][t][p]				// Doors closed: stay if at the destination; otherwise start moving
	|alarm -> ALARM_OPEN[f][p]),													// Alarm while the doors are not closed

// ALARM WITH DOORS NOT CLOSED: evacuate immediately at the ground floor; otherwise close the doors and go down
ALARM_OPEN[f:FLOORS][p:CABIN_STATE] =
	if (f == GROUND_FLOOR)
	then EVACUATE[p]
	else (door_closed -> ALARM_DOWN[f][p]),

// ALARM WITH CLOSED DOORS: go down to the ground floor without intermediate stops, then open the doors
ALARM_DOWN[f:FLOORS][p:CABIN_STATE] =
	if (f == GROUND_FLOOR)
	then (door_opened -> EVACUATE[p])
	else (at[f-1] -> ALARM_DOWN[f-1][p]),

// EVACUATION OF ANY PASSENGER AT THE GROUND FLOOR
EVACUATE[p:CABIN_STATE] =
	if (p == EMPTY)
	then LIFT_ALARM
	else (evacuate[h:FLOORS][u:USER_IDX] -> LIFT_ALARM),							// Only the passenger on board can synchronize

// WAIT FOR THE ALARM TO BE RESOLVED, THEN RETURN TO SERVICE
LIFT_ALARM = (alarm_solved -> OPEN[GROUND_FLOOR][GROUND_FLOOR][EMPTY]).

/*
	+--------------------------------------+
	|                USER                  |
	+--------------------------------------+

	Index dictionary:
	- u = user index
	- h = floor index
	- d = destination floor
*/

// INITIAL STATE
USER(H=0, U=1) = (call[H][U] -> WAITING),			// Presses the external call button

// WAITING FOR THE LIFT AT THE FLOOR
WAITING = (enter[H][U] -> INSIDE),					// Enters when it is their turn and the lift is at their floor with open doors

// USER INSIDE THE LIFT
INSIDE =
	(select[H][U][d:FLOORS] -> RIDING[d]			// Internal button: select floor d
	|evacuate[H][U] -> USER),						// Alarm: evacuated at the ground floor

// USER RIDING THE LIFT
RIDING[d:FLOORS] =
	(exit[H][U][d] -> USER							// Exit at the selected floor
	|evacuate[H][U] -> USER).						// Alarm: evacuated at the ground floor

// COMPOSITION OF ALL USERS
||USERS = (forall[h:FLOORS][u:USER_IDX] USER(h,u)).	// Compose all users in parallel

/*
	+--------------------------------------+
	|             CALL QUEUE               |
	+--------------------------------------+

	Index dictionary:
	- u = user index
	- h = floor index
	- n = # users in the queue
	- k = # users ahead of a given user
	- m = # users behind a given user
*/

// INITIAL STATE
TICKET(H=0, U=1) = OUT[0],										// User not in the queue; the queue is empty

// USER NOT IN THE QUEUE: n is the number of other users currently waiting
OUT[n:QUEUE_POS] =
	(call[h:FLOORS][u:USER_IDX] ->								// A user calls the lift
		if (h == H && u == U) then WAIT[n][0]					// Own call: join behind the n users already waiting
		else if (n + 1 < N_USERS) then OUT[n+1]					// Another user's call: one more user joins the queue
		else ERROR												// Queue full: unreachable case
	|when (n > 0) enter[h:FLOORS][u:USER_IDX] -> OUT[n-1]),		// A user enters the lift: the queue gets shorter

// USER IN THE QUEUE
WAIT[k:QUEUE_POS][m:QUEUE_POS] =
	(call[h:FLOORS][u:USER_IDX] ->								// Another user who was not in the queue calls the lift
		if (k + m + 1 < N_USERS) then WAIT[k][m+1]				// The new user joins at the back; the number behind increases
		else ERROR												// Queue full: unreachable case
	|when (k == 0) request[H][U] -> WAIT[k][m]					// At the head: request the lift and remain in the queue
	|when (k == 0) enter[H][U] -> OUT[m]						// At the head: enter the lift and leave the queue
	|when (k > 0) enter[h:FLOORS][u:USER_IDX] -> WAIT[k-1][m]).	// A user ahead enters: move one position closer to the head

// COMPOSITION OF ALL QUEUE TICKETS
||CALL_QUEUE = (forall[h:FLOORS][u:USER_IDX] TICKET(h,u)).		// Compose all tickets in parallel to form the FIFO queue

/*
	+--------------------------------------+
	|             FIRE ALARM               |
	+--------------------------------------+
*/

// EXTERNAL FIRE ALARM SYSTEM
FIRE_ALARM = (alarm -> alarm_solved -> FIRE_ALARM).	// Alternates between alarm and resolution

/*
	+--------------------------------------+
	|          SYSTEM COMPOSITION          |
	+--------------------------------------+
*/
||SYS = (LIFT || USERS || CALL_QUEUE || FIRE_ALARM).

/*
	+--------------------------------------+
	|          FLUENTS (FLTL)              |
	+--------------------------------------+

	Index dictionary:
	- f = lift floor
	- h = user's floor
	- u = user index
*/

set LIFT_POSITIONS = {at[FLOORS]}																// All the floors the lift can reach

fluent LIFT_AT[f:FLOORS] = <at[f], LIFT_POSITIONS \ {at[f]}> initially (f == GROUND_FLOOR)		// The lift is at floor f
fluent DOORS_OPEN = <door_opened, door_closed>													// The lift doors are open
fluent WAITING[h:FLOORS][u:USER_IDX] = <call[h][u], enter[h][u]>								// User u of floor h has called and has not boarded yet

/*
	+--------------------------------------+
	|          PROPERTIES (FLTL)           |
	+--------------------------------------+

	LTSA checks the liveness properties under the fair choice assumption, so every
	execution raises the alarm infinitely often ([]<>alarm holds) and an escape such as
	"<>(... || alarm)" would make every property trivially true. The alarm case is
	therefore handled without that escape:
	- EVENTUAL_ARRIVAL and STARVATION_FREEDOM hold even across alarms, because the
	  call queue survives the evacuation and the service resumes after alarm_solved;
	- EVENTUAL_DELIVERY allows the evacuation as the only alternative to reaching the
	  selected floor, since that is the only way an alarm can interrupt a ride.
*/

// SAFETY: only one user at a time in the cabin (after an enter, no other enter before exit/evacuate)
assert MUTUAL_EXCLUSION = [](enter[FLOORS][USER_IDX] -> X(!enter[FLOORS][USER_IDX] W {exit[FLOORS][USER_IDX][FLOORS], evacuate[FLOORS][USER_IDX]}))

// LIVENESS: if a user calls the lift, the lift eventually reaches the user's floor and opens the doors
assert EVENTUAL_ARRIVAL = forall[h:FLOORS][u:USER_IDX] [](call[h][u] -> <>(LIFT_AT[h] && DOORS_OPEN))

// LIVENESS: a passenger who selects floor d eventually exits at floor d (unless evacuated because of an alarm)
assert EVENTUAL_DELIVERY = forall[h:FLOORS][u:USER_IDX][d:FLOORS] [](select[h][u][d] -> <>(exit[h][u][d] || evacuate[h][u]))

// LIVENESS: a user waiting at a floor eventually gets the lift
assert STARVATION_FREEDOM = forall[h:FLOORS][u:USER_IDX] [](WAITING[h][u] -> <>enter[h][u])
